{
  "description": "DotZero auth status displayed at session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/auth-status.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
